<view class="login">
    <text class="login-title">登录</text>

    <block wx:if="{{wechatMode}}">
        <text class="login-desc">一键登录后即可投稿、收藏和晒成品。</text>
        <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="wechatLogin">
            微信一键登录
        </button>
        <text class="login-tip">登录仅用于识别你的投稿与收藏，不会读取手机号。</text>
        <text class="login-error" wx:if="{{error}}">{{error}}</text>
    </block>

    <block wx:else>
        <text class="login-desc">使用邮箱验证码登录或注册。</text>

        <input
            class="login-input"
            type="text"
            placeholder="邮箱"
            placeholder-class="login-placeholder"
            value="{{email}}"
            bindinput="onEmailInput"
        />

        <view class="login-row">
            <input
                class="login-input login-code"
                placeholder="验证码"
                placeholder-class="login-placeholder"
                value="{{code}}"
                bindinput="onCodeInput"
                bindconfirm="submit"
            />
            <view
                class="login-send {{sending || countdown > 0 ? 'login-send-disabled' : ''}}"
                bindtap="sendCode"
            >{{countdown > 0 ? countdown + ' 秒后重发' : (sending ? '发送中' : '获取验证码')}}</view>
        </view>

        <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">登录 / 注册</button>

        <text class="login-tip" wx:if="{{tip}}">{{tip}}</text>
        <text class="login-error" wx:if="{{error}}">{{error}}</text>
    </block>
</view>
