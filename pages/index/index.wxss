.page {
    min-height: 100vh;
    background: var(--bg);
}

/* ---------- 头部 ---------- */

.hero {
    position: relative;
    overflow: hidden;
    padding: 20rpx 28rpx 100rpx;
    background: linear-gradient(168deg, #fffaf5 0%, #ffeede 56%, #fff8f3 100%);
    border-radius: 0 0 44rpx 44rpx;
}

.hero-glow {
    position: absolute;
    top: -140rpx;
    right: -120rpx;
    width: 420rpx;
    height: 420rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 160, 100, 0.35) 0%, rgba(255, 160, 100, 0) 68%);
    pointer-events: none;
}

.hero-top {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20rpx;
    padding-top: 8rpx;
}

.hero-eyebrow {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 2rpx;
    color: var(--brand-500);
}

.hero-title {
    margin-top: 8rpx;
    font-size: 50rpx;
    font-weight: 800;
    letter-spacing: 2rpx;
    line-height: 1.2;
    color: #2b1d16;
}

.hero-sub {
    margin-top: 8rpx;
    font-size: var(--fs-sm);
    color: #a1806c;
}

.hero-badge {
    flex-shrink: 0;
    margin-top: 6rpx;
    padding: 8rpx 18rpx;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.8);
    border: 2rpx solid rgba(255, 255, 255, 0.9);
    color: var(--brand-600);
    font-size: 21rpx;
    font-weight: 600;
    letter-spacing: 0.5rpx;
}

/* 搜索 */
.search-box {
    position: relative;
    margin-top: 30rpx;
    height: 88rpx;
    padding: 0 12rpx 0 28rpx;
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: var(--r-pill);
    box-shadow: 0 12rpx 32rpx rgba(196, 85, 42, 0.1);
    transition: opacity var(--dur) var(--ease);
}

.search-ico {
    width: 26rpx;
    height: 26rpx;
    border: 3rpx solid var(--brand-500);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
    margin-right: 18rpx;
}

.search-ico::after {
    content: "";
    position: absolute;
    right: -9rpx;
    bottom: -4rpx;
    width: 12rpx;
    height: 3rpx;
    border-radius: 3rpx;
    background: var(--brand-500);
    transform: rotate(45deg);
}

.search-ph {
    flex: 1;
    font-size: 27rpx;
    color: var(--ink-400);
}

.search-go {
    flex-shrink: 0;
    padding: 12rpx 26rpx;
    border-radius: var(--r-pill);
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: 24rpx;
    font-weight: 600;
}

/* ---------- 抽菜入口 ---------- */

.roll-entry {
    position: relative;
    margin-top: -72rpx;
    padding: 26rpx 28rpx;
    display: flex;
    align-items: center;
    gap: 22rpx;
    background: linear-gradient(118deg, #ff8046 0%, #ff5a26 62%, #f04a18 100%);
    border-radius: var(--r-xl);
    box-shadow: 0 18rpx 38rpx rgba(239, 78, 25, 0.3);
    overflow: hidden;
    transition: transform 0.16s var(--ease);
}

.roll-emoji {
    width: 84rpx;
    height: 84rpx;
    flex-shrink: 0;
    border-radius: 24rpx;
    background: rgba(255, 255, 255, 0.2);
    border: 2rpx solid rgba(255, 255, 255, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    line-height: 1;
}

.roll-left {
    flex: 1;
    min-width: 0;
}

.roll-title {
    font-size: var(--fs-xl);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 1rpx;
}

.roll-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.82);
}

.roll-action {
    flex-shrink: 0;
    padding: 14rpx 28rpx;
    background: #ffffff;
    color: var(--brand-600);
    font-size: 25rpx;
    font-weight: 700;
    border-radius: var(--r-pill);
    box-shadow: 0 6rpx 16rpx rgba(120, 40, 10, 0.16);
}

/* ---------- 公告 ---------- */

.notice {
    margin-top: 24rpx;
    padding: 16rpx 20rpx;
    display: flex;
    align-items: center;
    gap: 14rpx;
    background: #fffaf2;
    border: 2rpx solid #ffe6c7;
    border-radius: var(--r-md);
}

.notice-tag {
    flex-shrink: 0;
    padding: 2rpx 12rpx;
    background: var(--warn);
    color: #ffffff;
    font-size: 20rpx;
    font-weight: 600;
    border-radius: 6rpx;
}

.notice-text {
    font-size: 24rpx;
    color: #7d5a34;
}

.notice-arrow {
    width: 12rpx;
    height: 12rpx;
    flex-shrink: 0;
    border-right: 3rpx solid #cba876;
    border-top: 3rpx solid #cba876;
    transform: rotate(45deg);
    margin-right: 6rpx;
}

/* ---------- 菜系 / 快捷标签 ---------- */

.cuisine-scroll {
    margin-top: 28rpx;
    white-space: nowrap;
}

.cuisine-item {
    display: inline-flex;
    align-items: center;
    height: 64rpx;
    margin-right: 14rpx;
    padding: 0 26rpx;
    background: var(--surface);
    border: 2rpx solid var(--line);
    border-radius: var(--r-pill);
    font-size: var(--fs-base);
    color: var(--ink-700);
    vertical-align: top;
    transition: opacity var(--dur) var(--ease);
}

.chip-press {
    opacity: 0.65;
}

.quick-row {
    margin-top: 16rpx;
    display: flex;
    flex-wrap: wrap;
    gap: 14rpx;
}

.chip-quick {
    background: var(--brand-50);
    border-color: transparent;
    color: var(--brand-600);
    font-weight: 500;
}

/* ---------- 精选横滑 ---------- */

.feature-scroll {
    white-space: nowrap;
}

.feature-item {
    display: inline-block;
    width: 304rpx;
    margin-right: 18rpx;
    vertical-align: top;
    background: var(--surface);
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 2rpx solid rgba(237, 230, 221, 0.9);
    transition: transform 0.16s var(--ease);
}

.feature-media {
    position: relative;
    line-height: 0;
}

.feature-cover {
    width: 304rpx;
    height: 196rpx;
    background: var(--line-soft);
}

.feature-cover-empty {
    background: linear-gradient(135deg, #ffe3d2, #ffc8ab);
}

.feature-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: linear-gradient(to top, rgba(27, 25, 23, 0.42), rgba(27, 25, 23, 0) 55%);
}

.feature-flag {
    position: absolute;
    top: 14rpx;
    left: 14rpx;
    padding: 4rpx 14rpx;
    border-radius: 8rpx;
    background: rgba(255, 255, 255, 0.94);
    color: var(--brand-600);
    font-size: 20rpx;
    font-weight: 700;
    line-height: 1.7;
}

.feature-body {
    padding: 16rpx 18rpx 20rpx;
}

.feature-name {
    display: block;
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--ink-900);
}

.feature-meta {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--ink-400);
}

/* ---------- 两列网格 ---------- */

.grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    row-gap: 20rpx;
}

.grid-cell {
    width: calc(50% - 10rpx);
}

.retry {
    margin-top: 28rpx;
    width: 260rpx;
}

.foot-hint {
    margin: 52rpx 0 12rpx;
    text-align: center;
    font-size: 21rpx;
    color: var(--ink-300);
    letter-spacing: 1rpx;
}

/* ---------- 骨架屏 ---------- */

.sk-sec {
    margin-top: 44rpx;
}

.sk-title {
    width: 200rpx;
    height: 34rpx;
    margin-bottom: 22rpx;
}

.sk-hscroll {
    display: flex;
    gap: 18rpx;
    overflow: hidden;
}

.sk-cover {
    width: 304rpx;
    height: 240rpx;
    border-radius: var(--r-lg);
    flex-shrink: 0;
}

.sk-tile {
    height: 420rpx;
    border-radius: var(--r-lg);
}

/* ---------- 抽菜弹层 ---------- */

.modal-mask {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background: rgba(30, 22, 17, 0.52);
    z-index: 100;
    display: flex;
    align-items: flex-end;
    animation: mask-in 0.24s var(--ease) both;
}

.modal {
    width: 100%;
    max-height: 88vh;
    background: var(--bg);
    border-radius: 40rpx 40rpx 0 0;
    padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    animation: sheet-up 0.34s var(--ease) both;
}

.modal-grip {
    width: 68rpx;
    height: 8rpx;
    border-radius: var(--r-pill);
    background: var(--ink-300);
    opacity: 0.5;
    margin: 0 auto 16rpx;
}

.modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 8rpx;
}

.modal-title {
    display: block;
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: 1rpx;
}

.modal-sub {
    display: block;
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--ink-400);
}

.modal-close {
    width: 56rpx;
    height: 56rpx;
    line-height: 52rpx;
    text-align: center;
    border-radius: 50%;
    background: var(--surface);
    font-size: 40rpx;
    color: var(--ink-400);
}

.modal-scroll {
    max-height: 74vh;
}

.filter-line {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 14rpx;
}

.roll-body {
    margin-top: 26rpx;
}

.roll-loading {
    padding: 90rpx 0;
    text-align: center;
    font-size: var(--fs-base);
    color: var(--ink-400);
}

.roll-empty {
    padding: 60rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.roll-media {
    border-radius: var(--r-lg);
    overflow: hidden;
    line-height: 0;
    box-shadow: var(--sh-2);
}

.roll-cover {
    width: 100%;
    height: 356rpx;
    background: var(--line-soft);
}

.roll-cover-empty {
    background: linear-gradient(135deg, #ffe3d2, #ffc8ab);
}

.roll-name {
    margin-top: 24rpx;
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: 1rpx;
    line-height: 1.25;
}

.roll-meta {
    margin-top: 10rpx;
    font-size: 23rpx;
    color: var(--ink-400);
}

.roll-summary {
    margin-top: 16rpx;
    font-size: var(--fs-base);
    color: var(--ink-700);
    line-height: 1.65;
}

.roll-tags {
    margin-top: 14rpx;
}

.roll-material {
    margin-top: 18rpx;
    padding: 18rpx 22rpx;
    background: var(--brand-50);
    border-radius: var(--r-md);
}

.roll-material-label {
    font-size: 21rpx;
    font-weight: 600;
    color: var(--brand-600);
    margin-right: 12rpx;
}

.roll-material-text {
    font-size: 24rpx;
    color: #6b5b52;
}

.roll-actions {
    margin-top: 28rpx;
    display: flex;
    gap: 14rpx;
}

.roll-actions .btn {
    flex: 1;
}

@keyframes mask-in {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes sheet-up {
    from {
        transform: translateY(100%);
    }
    to {
        transform: translateY(0);
    }
}

/* ---------- 今日想喝 ---------- */

.drink-entry {
    margin-top: 20rpx;
    padding: 24rpx 26rpx;
    display: flex;
    align-items: center;
    gap: 20rpx;
    background: linear-gradient(118deg, #fff7f0 0%, #ffeadf 58%, #ffe4ef 100%);
    border: 2rpx solid #ffe1ce;
    border-radius: var(--r-xl);
    box-shadow: var(--sh-2);
    transition: transform 0.16s var(--ease);
}

.drink-emoji {
    width: 84rpx;
    height: 84rpx;
    flex-shrink: 0;
    border-radius: 24rpx;
    background: rgba(255, 255, 255, 0.72);
    border: 2rpx solid rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    line-height: 1;
}

.drink-title {
    font-size: var(--fs-xl);
    font-weight: 700;
    color: #4a2f22;
    letter-spacing: 1rpx;
}

.drink-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #a97a5f;
}

.drink-action {
    flex-shrink: 0;
    padding: 14rpx 26rpx;
    background: #ffffff;
    color: #c2532a;
    font-size: 25rpx;
    font-weight: 700;
    border-radius: var(--r-pill);
    box-shadow: 0 6rpx 16rpx rgba(160, 80, 40, 0.14);
}

.drink-modal {
    padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.drink-kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 20rpx;
}

/* ---------- 滚盘 ---------- */

.reel {
    position: relative;
    height: 324rpx;
    margin-top: 22rpx;
    border-radius: var(--r-lg);
    background: #fffaf6;
    border: 2rpx solid #ffe3d2;
    overflow: hidden;
}

.reel-focus {
    position: absolute;
    left: 16rpx;
    right: 16rpx;
    top: 108rpx;
    height: 108rpx;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, #fff2e7, #ffe2d0);
    border: 2rpx solid #ffc9a6;
    box-sizing: border-box;
}

.reel-fade {
    position: absolute;
    left: 0;
    right: 0;
    height: 84rpx;
    z-index: 3;
    pointer-events: none;
}

.reel-fade-top {
    top: 0;
    background: linear-gradient(180deg, #fffaf6 10%, rgba(255, 250, 246, 0));
}

.reel-fade-bottom {
    bottom: 0;
    background: linear-gradient(0deg, #fffaf6 10%, rgba(255, 250, 246, 0));
}

.reel-track {
    position: relative;
    z-index: 2;
    padding-top: 108rpx;
    display: flex;
    flex-direction: column;
    will-change: transform;
}

.reel-track-run {
    transition: transform 1.5s cubic-bezier(0.16, 0.84, 0.14, 1);
}

.reel-item {
    height: 108rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.reel-name {
    font-size: 34rpx;
    font-weight: 700;
    color: var(--ink-900);
    letter-spacing: 1rpx;
}

.reel-kind {
    margin-top: 4rpx;
    font-size: 21rpx;
    color: #b08872;
}

/* ---------- 结果 ---------- */

.drink-result {
    margin-top: 24rpx;
    padding: 26rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-2);
    animation: result-in 0.26s var(--ease) both;
}

.drink-result-head {
    display: flex;
    align-items: center;
    gap: 14rpx;
}

.drink-brand {
    font-size: var(--fs-2xl);
    font-weight: 800;
    letter-spacing: 1rpx;
}

.drink-tag {
    padding: 4rpx 14rpx;
    border-radius: var(--r-pill);
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: 20rpx;
    font-weight: 600;
}

.drink-star {
    margin-top: 12rpx;
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--ink-800);
}

.drink-note {
    margin-top: 8rpx;
    font-size: 23rpx;
    color: var(--ink-400);
    line-height: 1.6;
}

.drink-price {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #b08872;
}

.drink-rolling {
    padding: 52rpx 0 16rpx;
    text-align: center;
    font-size: var(--fs-base);
    color: var(--ink-400);
}

@keyframes result-in {
    from {
        opacity: 0;
        transform: translateY(12rpx);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
