<view class="page">
    <view class="state" wx:if="{{loading}}">
        <view class="loading-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
        </view>
    </view>

    <view class="state" wx:elif="{{error}}">
        <text class="state-emoji">🥲</text>
        <text class="state-text">{{error}}</text>
    </view>

    <block wx:elif="{{author}}">
        <view class="header">
            <view class="avatar avatar-lg">{{author.initial}}</view>
            <view class="name">{{author.name}}</view>
            <view class="nums">
                <view class="num-item">
                    <text class="num">{{author.recipes.length}}</text>
                    <text class="num-label">菜谱</text>
                </view>
                <view class="num-item">
                    <text class="num">{{author.posts.length}}</text>
                    <text class="num-label">帖子</text>
                </view>
                <view class="num-item">
                    <text class="num">{{author.fans}}</text>
                    <text class="num-label">粉丝</text>
                </view>
                <view class="num-item">
                    <text class="num">{{author.followingCount}}</text>
                    <text class="num-label">关注</text>
                </view>
            </view>
            <view class="btn btn-sm follow {{author.following ? 'btn-plain' : 'btn-primary'}}" bindtap="onFollow">
                {{author.following ? '已关注' : '关注 TA'}}
            </view>
        </view>

        <view class="container">
            <view class="tabs">
                <view class="tab {{tab === 'recipe' ? 'tab-active' : ''}}" data-tab="recipe" bindtap="switchTab">菜谱</view>
                <view class="tab {{tab === 'post' ? 'tab-active' : ''}}" data-tab="post" bindtap="switchTab">帖子</view>
            </view>

            <block wx:if="{{tab === 'recipe'}}">
                <view class="grid" wx:if="{{list.length}}">
                    <view class="grid-cell" wx:for="{{list}}" wx:key="id">
                        <recipe-card item="{{item}}" mode="grid" />
                    </view>
                </view>
                <view class="state" wx:else>
                    <text class="state-text">TA 还没有公开的菜谱</text>
                </view>
            </block>

            <block wx:else>
                <view
                    class="post"
                    wx:for="{{list}}"
                    wx:key="id"
                    data-id="{{item.id}}"
                    data-kind="post"
                    bindtap="goDetail"
                >
                    <view class="post-title">{{item.title}}</view>
                    <view class="post-content ellipsis-2" wx:if="{{item.content}}">{{item.content}}</view>
                    <image wx:if="{{item.cover}}" class="post-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
                    <view class="post-foot">
                        <text>{{item.timeText}}</text>
                        <text>♥ {{item.like_count}}</text>
                    </view>
                </view>
                <view class="state" wx:if="{{!list.length}}">
                    <text class="state-text">TA 还没有公开的帖子</text>
                </view>
            </block>
        </view>
    </block>
</view>
