.page {
    min-height: 100vh;
    background: var(--bg);
    padding-bottom: 40rpx;
}

/* ---------- 头部 ---------- */

.header {
    position: relative;
    overflow: hidden;
    padding: 30rpx 28rpx 72rpx;
    background: linear-gradient(160deg, #fffaf5 0%, #ffeede 60%, #fff8f3 100%);
    border-radius: 0 0 44rpx 44rpx;
}

.header-glow {
    position: absolute;
    top: -150rpx;
    right: -120rpx;
    width: 420rpx;
    height: 420rpx;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 160, 100, 0.32) 0%, rgba(255, 160, 100, 0) 68%);
}

.header-eyebrow {
    position: relative;
    font-size: 21rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
    color: var(--brand-500);
}

.header-title {
    position: relative;
    margin-top: 8rpx;
    font-size: 46rpx;
    font-weight: 800;
    letter-spacing: 1rpx;
    color: #2b1d16;
}

.header-sub {
    position: relative;
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #a1806c;
}

.container {
    position: relative;
    margin-top: -44rpx;
}

/* ---------- 添加 ---------- */

.add-card {
    display: flex;
    align-items: center;
    gap: 12rpx;
    padding: 16rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-2);
}

.add-input {
    flex: 1.5;
    height: 72rpx;
    padding: 0 20rpx;
    background: var(--surface-soft);
    border-radius: var(--r-sm);
    font-size: 25rpx;
    color: var(--ink-900);
}

.add-dosage {
    flex: 0.9;
    height: 72rpx;
    padding: 0 20rpx;
    background: var(--surface-soft);
    border-radius: var(--r-sm);
    font-size: 25rpx;
    color: var(--ink-900);
}

.ph {
    color: var(--ink-300);
}

.add-btn {
    flex-shrink: 0;
    padding: 0 26rpx;
    height: 72rpx;
    line-height: 72rpx;
    background: linear-gradient(135deg, #ff8b54, #ef4e19);
    color: #ffffff;
    font-size: 25rpx;
    font-weight: 600;
    border-radius: var(--r-sm);
    box-shadow: 0 8rpx 18rpx rgba(239, 78, 25, 0.22);
}

/* ---------- 列表 ---------- */

.list-card {
    margin-top: 20rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 4rpx 24rpx;
    box-shadow: var(--sh-1);
}

.item {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 24rpx 0;
    border-bottom: 2rpx solid var(--line-soft);
}

.item:last-child {
    border-bottom: none;
}

.check {
    width: 44rpx;
    height: 44rpx;
    flex-shrink: 0;
    border-radius: 14rpx;
    border: 2rpx solid var(--ink-300);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
}

.check-on {
    background: linear-gradient(135deg, var(--brand-400), var(--brand-600));
    border-color: transparent;
}

.check-mark {
    color: #ffffff;
    font-size: 24rpx;
    line-height: 1;
}

.item-name {
    font-size: var(--fs-md);
    color: var(--ink-800);
}

.item-sub {
    margin-top: 4rpx;
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 21rpx;
    color: var(--ink-400);
}

.item-source {
    color: var(--brand-500);
}

.item-done .item-name {
    color: var(--ink-300);
    text-decoration: line-through;
}

.del {
    flex-shrink: 0;
    width: 48rpx;
    height: 48rpx;
    line-height: 44rpx;
    text-align: center;
    font-size: 32rpx;
    color: var(--ink-300);
}

/* ---------- 操作 ---------- */

.ops {
    margin-top: 24rpx;
    display: flex;
    gap: 16rpx;
}

.op {
    flex: 1;
    height: 80rpx;
    font-size: 26rpx;
}

.state {
    padding: 120rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* ---------- 未登录引导 ---------- */

.guest-card {
    margin-top: 10rpx;
    padding: 60rpx 40rpx 48rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-2);
}

.guest-emoji {
    font-size: 68rpx;
    line-height: 1;
}

.guest-title {
    margin-top: 24rpx;
    font-size: 32rpx;
    font-weight: 700;
    color: var(--ink-900);
}

.guest-text {
    margin-top: 14rpx;
    font-size: 24rpx;
    line-height: 1.75;
    color: var(--ink-400);
    text-align: center;
}

.guest-btn {
    width: 360rpx;
    height: 84rpx;
    margin-top: 36rpx;
    font-size: 28rpx;
}
