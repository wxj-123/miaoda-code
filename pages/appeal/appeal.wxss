.page {
    min-height: 100vh;
    background: var(--bg);
    padding-top: 20rpx;
}

/* ---------- 驳回说明 ---------- */

.hero {
    position: relative;
    padding: 30rpx 28rpx;
    border-radius: var(--r-lg);
    background: #fff3f0;
    border: 2rpx solid #ffd9d0;
    box-shadow: var(--sh-1);
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8rpx;
    background: linear-gradient(180deg, #ff8b54, #d9483b);
}

.hero-pending {
    background: #fff9ec;
    border-color: #f6e2b8;
}

.hero-pending::before {
    background: linear-gradient(180deg, #f2c163, #e8a33d);
}

.hero-tag {
    display: inline-block;
    padding: 4rpx 16rpx;
    border-radius: 8rpx;
    background: rgba(217, 72, 59, 0.1);
    color: #c43c10;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 1rpx;
}

.hero-pending .hero-tag {
    background: rgba(232, 163, 61, 0.16);
    color: #a9701a;
}

.hero-title {
    margin-top: 16rpx;
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--ink-900);
}

.hero-reason {
    margin-top: 10rpx;
    font-size: var(--fs-base);
    line-height: 1.7;
    color: var(--ink-700);
}

.rule-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-top: 18rpx;
}

.rule {
    padding: 4rpx 16rpx;
    border-radius: var(--r-pill);
    background: #ffffff;
    border: 2rpx solid #ffd9d0;
    color: #b8432f;
    font-size: var(--fs-xs);
}

.hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 2rpx dashed rgba(217, 72, 59, 0.18);
    color: var(--ink-500);
    font-size: var(--fs-xs);
}

/* ---------- 表单块 ---------- */

.block {
    margin-top: 22rpx;
    padding: 26rpx 24rpx;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--sh-1);
}

.block-label {
    margin-bottom: 14rpx;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 2rpx;
    color: var(--ink-400);
}

.block-tip {
    margin-top: 12rpx;
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--ink-400);
}

.title-input {
    width: 100%;
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--ink-900);
}

.body-input {
    width: 100%;
    min-height: 200rpx;
    font-size: var(--fs-md);
    line-height: 1.75;
    color: var(--ink-800);
}

.reason-input {
    min-height: 140rpx;
}

.ph {
    color: var(--ink-300);
}

/* ---------- 图片 ---------- */

.media-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.media-item {
    position: relative;
    width: 156rpx;
    height: 156rpx;
}

.media-img {
    width: 156rpx;
    height: 156rpx;
    border-radius: var(--r-sm);
    background: var(--line-soft);
}

.media-del {
    position: absolute;
    right: -8rpx;
    top: -8rpx;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    background: rgba(35, 38, 43, 0.72);
    color: #ffffff;
    font-size: 26rpx;
    line-height: 40rpx;
    text-align: center;
}

.media-add {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 156rpx;
    height: 156rpx;
    border-radius: var(--r-sm);
    border: 2rpx dashed var(--ink-300);
    background: var(--surface-soft);
    color: var(--ink-400);
}

.media-add-ico {
    font-size: 40rpx;
    line-height: 1;
}

.media-add-text {
    margin-top: 6rpx;
    font-size: var(--fs-xs);
}

/* ---------- 食材 / 步骤 ---------- */

.line {
    display: flex;
    align-items: center;
    gap: 14rpx;
    padding: 12rpx 0;
    border-bottom: 2rpx solid var(--line-soft);
}

.line-input {
    font-size: var(--fs-md);
    color: var(--ink-800);
}

.line-dosage {
    width: 170rpx;
    text-align: right;
    color: var(--ink-500);
}

.step-no {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: var(--fs-xs);
    font-weight: 600;
    flex-shrink: 0;
}

.line-del {
    width: 44rpx;
    text-align: center;
    color: var(--ink-300);
    font-size: 30rpx;
}

.line-add {
    margin-top: 16rpx;
    padding: 10rpx 0;
    color: var(--brand-600);
    font-size: var(--fs-sm);
}

/* ---------- 历史申诉 ---------- */

.history-item {
    padding: 16rpx 0;
    border-bottom: 2rpx solid var(--line-soft);
}

.history-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.history-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.history-round {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-700);
}

.history-status {
    font-size: var(--fs-xs);
    padding: 2rpx 14rpx;
    border-radius: 8rpx;
}

.st-pass {
    background: #eef6f1;
    color: #2e9e6b;
}

.st-reject {
    background: #fff3f0;
    color: #c43c10;
}

.st-wait {
    background: #fff9ec;
    color: #a9701a;
}

.history-reason,
.history-reply {
    margin-top: 8rpx;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-500);
}

.limit-tip {
    margin-top: 22rpx;
    padding: 22rpx 24rpx;
    border-radius: var(--r-md);
    background: var(--surface-soft);
    border: 2rpx dashed var(--line);
    color: var(--ink-500);
    font-size: var(--fs-sm);
    line-height: 1.7;
}
