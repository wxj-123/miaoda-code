<view class="page">
    <scroll-view class="tabs" scroll-x enable-flex show-scrollbar="{{false}}">
        <view
            class="tab {{tab === item.key ? 'tab-active' : ''}}"
            wx:for="{{tabs}}"
            wx:key="key"
            data-tab="{{item.key}}"
            bindtap="switchTab"
        >{{item.label}}</view>
    </scroll-view>

    <view class="container">
        <view class="state" wx:if="{{loading}}">
            <view class="loading-dots">
                <view class="dot"></view>
                <view class="dot"></view>
                <view class="dot"></view>
            </view>
        </view>

        <block wx:elif="{{list.length}}">
            <view
                class="item {{item.audit_status === 3 ? 'item-rejected' : ''}}"
                wx:for="{{list}}"
                wx:key="id"
                data-id="{{item.id}}"
                data-kind="{{item.kind}}"
                data-status="{{item.audit_status}}"
                bindtap="goDetail"
            >
                <image wx:if="{{item.cover}}" class="item-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
                <view wx:else class="item-cover item-cover-empty"></view>

                <view class="flex1 item-body">
                    <view class="item-title ellipsis">{{item.name || item.title}}</view>
                    <view class="item-meta">
                        <text class="tag-plain">{{item.kindText}}</text>
                        <text class="status {{item.statusClass}}">{{item.statusText}}</text>
                        <text class="muted">{{item.timeText}}</text>
                    </view>
                    <view class="item-reason" wx:if="{{item.audit_status === 3}}">
                        驳回理由：{{item.reject_reason || '内容不符合社区规范'}}
                    </view>
                    <view
                        class="item-action"
                        wx:if="{{item.canAppeal || item.appealPending}}"
                        data-id="{{item.id}}"
                        data-kind="{{item.kind}}"
                        catchtap="goAppeal"
                    >
                        <text class="item-action-text">{{item.actionText}}</text>
                        <text class="item-action-arrow">›</text>
                    </view>
                    <view class="item-action is-disabled" wx:elif="{{item.audit_status === 3}}">
                        <text class="item-action-text">{{item.actionText}}</text>
                    </view>
                </view>
            </view>
        </block>

        <view class="state" wx:else>
            <text class="state-emoji">📄</text>
            <text class="state-text">这里还没有内容</text>
        </view>
    </view>
</view>
