<view class="page">

    <!-- 权限校验中 -->
    <view class="boot" wx:if="{{checking}}">
        <view class="loading-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
        </view>
    </view>

    <!-- 无审核权限 -->
    <view class="noauth" wx:elif="{{!isAdmin}}">
        <view class="noauth-card">
            <view class="noauth-mark">A</view>
            <view class="noauth-title">当前账号不是审核员</view>
            <view class="noauth-text">管理台可以审核菜谱与帖子、处理举报、管理内容与用户、维护公告和敏感词库。</view>
            <view class="noauth-split"></view>
            <view class="noauth-label">首次初始化</view>
            <view class="noauth-text noauth-text-sm">仅当系统里一个审核员都没有时可用。绑定后你就是第一个管理员，之后新管理员需由你授权。</view>
            <view class="btn btn-primary noauth-btn" bindtap="claim" hover-class="btn-press">绑定当前账号为审核员</view>
        </view>
    </view>

    <!-- 管理台 -->
    <block wx:else>
        <view class="hero">
            <view class="hero-orb hero-orb-a"></view>
            <view class="hero-orb hero-orb-b"></view>
            <view class="hero-inner">
                <view class="hero-row">
                    <view class="flex1">
                        <view class="hero-eyebrow">ADMIN CONSOLE</view>
                        <view class="hero-title">{{heroTitle}}</view>
                        <view class="hero-sub">{{heroSub}}</view>
                    </view>
                    <view class="hero-refresh" bindtap="refresh" hover-class="is-press">
                        <text class="refresh-glyph {{loading ? 'spinning' : ''}}">↻</text>
                    </view>
                </view>
                <view class="hero-foot">
                    <text class="hero-role">审核员</text>
                    <text class="hero-time">{{refreshedAt ? refreshedAt + ' 已同步' : '正在同步'}}</text>
                </view>
            </view>
        </view>

        <view class="stats">
            <view class="stat" data-tab="audit" bindtap="switchTab" hover-class="stat-press">
                <view class="stat-top"><view class="stat-dot dot-warn"></view><text class="stat-label">待审核</text></view>
                <text class="stat-num num">{{stats.pendingText}}</text>
            </view>
            <view class="stat" data-tab="report" bindtap="switchTab" hover-class="stat-press">
                <view class="stat-top"><view class="stat-dot dot-danger"></view><text class="stat-label">待处理举报</text></view>
                <text class="stat-num num">{{stats.reportsText}}</text>
            </view>
            <view class="stat" data-tab="content" bindtap="switchTab" hover-class="stat-press">
                <view class="stat-top"><view class="stat-dot dot-ink"></view><text class="stat-label">内容总数</text></view>
                <text class="stat-num num">{{stats.contentsText}}</text>
            </view>
            <view class="stat" data-tab="user" bindtap="switchTab" hover-class="stat-press">
                <view class="stat-top"><view class="stat-dot dot-ok"></view><text class="stat-label">贡献者</text></view>
                <text class="stat-num num">{{stats.usersText}}</text>
            </view>
        </view>

        <view class="tabbar">
            <view
                class="tab {{tab === item.key ? 'tab-active' : ''}}"
                wx:for="{{tabs}}"
                wx:key="key"
                data-tab="{{item.key}}"
                bindtap="switchTab"
                hover-class="is-press"
            >
                <text class="tab-label">{{item.label}}</text>
                <text class="tab-badge" wx:if="{{item.key === 'audit' && badge.audit}}">{{badge.auditText}}</text>
                <text class="tab-badge" wx:if="{{item.key === 'appeal' && badge.appeal}}">{{badge.appealText}}</text>
                <text class="tab-badge" wx:if="{{item.key === 'report' && badge.report}}">{{badge.reportText}}</text>
            </view>
        </view>

        <view class="container">
            <view class="tab-hint">
                <view class="hint-rule"></view>
                <text class="hint-text">{{tabHint}}</text>
            </view>

            <view class="loading-dots" wx:if="{{loading}}">
                <view class="dot"></view>
                <view class="dot"></view>
                <view class="dot"></view>
            </view>

            <!-- ===================== 审核 ===================== -->
            <block wx:elif="{{tab === 'audit'}}">
                <view class="filters">
                    <view
                        class="filter {{auditFilter === item.key ? 'filter-on' : ''}}"
                        wx:for="{{auditFilters}}"
                        wx:key="key"
                        data-key="{{item.key}}"
                        bindtap="onAuditFilter"
                        hover-class="is-press"
                    >
                        <text>{{item.label}}</text>
                        <text class="filter-num">{{item.key === 'all' ? auditCounts.all : item.key === 'recipe' ? auditCounts.recipe : auditCounts.post}}</text>
                    </view>
                </view>

                <view class="audit-card anim-in" wx:for="{{pendingView}}" wx:key="id">
                    <view class="audit-main" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="goDetail" hover-class="row-press">
                        <image wx:if="{{item.cover}}" class="audit-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
                        <view wx:else class="audit-cover cover-empty">
                            <text class="cover-word">{{item.kind === 'recipe' ? '菜谱' : '帖子'}}</text>
                        </view>
                        <view class="audit-body">
                            <view class="audit-head">
                                <text class="kind-chip {{item.kindClass}}">{{item.kindText}}</text>
                                <text class="audit-time">{{item.timeText}}</text>
                            </view>
                            <view class="audit-title ellipsis-2">{{item.title}}</view>
                            <view class="audit-excerpt ellipsis-2" wx:if="{{item.excerpt}}">{{item.excerpt}}</view>
                            <view class="audit-owner" wx:if="{{item.owner_name}}">
                                <text class="mini-avatar">{{item.initial}}</text>
                                <text class="owner-name ellipsis">{{item.owner_name}}</text>
                            </view>
                        </view>
                    </view>
                    <view class="audit-ops">
                        <view class="btn btn-plain btn-sm flex1" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="reject" hover-class="btn-press">驳回</view>
                        <view class="btn btn-primary btn-sm flex1" data-kind="{{item.kind}}" data-id="{{item.id}}" bindtap="approve" hover-class="btn-press">通过</view>
                    </view>
                </view>

                <view class="empty-state" wx:if="{{!pendingView.length}}">
                    <view class="empty-mark empty-mark-ok">✓</view>
                    <view class="empty-title">待审池是空的</view>
                    <view class="empty-desc">用户提交新内容后会排到这里，记得回来看看。</view>
                </view>
            </block>

            <!-- ===================== 申诉 ===================== -->
            <block wx:elif="{{tab === 'appeal'}}">
                <view class="audit-card anim-in" wx:for="{{appealView}}" wx:key="id">
                    <view class="audit-main">
                        <view class="audit-body">
                            <view class="audit-head">
                                <text class="kind-chip k-post">{{item.kindText}}</text>
                                <text class="audit-time">{{item.roundText}} · {{item.timeText}}</text>
                            </view>
                            <view class="audit-title ellipsis-2">{{item.title}}</view>

                            <view class="appeal-row">
                                <text class="appeal-label">驳回理由</text>
                                <text class="appeal-value">{{item.reject_reason || '未填写'}}</text>
                            </view>
                            <view class="appeal-row" wx:if="{{item.reason}}">
                                <text class="appeal-label">用户说明</text>
                                <text class="appeal-value">{{item.reason}}</text>
                            </view>
                            <view class="appeal-row" wx:if="{{item.currentText}}">
                                <text class="appeal-label">当前内容</text>
                                <text class="appeal-value ellipsis-3">{{item.currentText}}</text>
                            </view>

                            <view class="audit-owner">
                                <text class="mini-avatar">{{item.initial}}</text>
                                <text class="owner-name ellipsis">{{item.owner_name}}</text>
                            </view>
                        </view>
                    </view>
                    <view class="audit-ops">
                        <view class="btn btn-plain btn-sm flex1" data-id="{{item.id}}" bindtap="rejectAppeal" hover-class="btn-press">维持驳回</view>
                        <view class="btn btn-primary btn-sm flex1" data-id="{{item.id}}" bindtap="approveAppeal" hover-class="btn-press">通过申诉</view>
                    </view>
                </view>

                <view class="empty-state" wx:if="{{!appealView.length}}">
                    <view class="empty-mark empty-mark-ok">✓</view>
                    <view class="empty-title">没有待处理的申诉</view>
                    <view class="empty-desc">用户对驳回结果有异议时会提交到这里。</view>
                </view>
            </block>

            <!-- ===================== 举报 ===================== -->
            <block wx:elif="{{tab === 'report'}}">
                <view class="filters">
                    <view
                        class="filter {{reportFilter === item.key ? 'filter-on' : ''}}"
                        wx:for="{{reportFilters}}"
                        wx:key="key"
                        data-key="{{item.key}}"
                        bindtap="onReportFilter"
                        hover-class="is-press"
                    >
                        <text>{{item.label}}</text>
                        <text class="filter-num">{{item.key === 'all' ? reportCounts.all : item.key === 'pending' ? reportCounts.pending : reportCounts.done}}</text>
                    </view>
                </view>

                <view class="report-card anim-in" wx:for="{{reportView}}" wx:key="id">
                    <view class="report-head">
                        <text class="status {{item.statusClass}}">{{item.statusText}}</text>
                        <text class="reason-chip">{{item.reason}}</text>
                        <text class="report-time">{{item.timeText}}</text>
                    </view>

                    <view class="report-target" data-kind="{{item.target_type}}" data-id="{{item.target_id}}" bindtap="goDetail" hover-class="is-press">
                        <text class="target-kind">{{item.typeText}}</text>
                        <text class="target-title ellipsis flex1">{{item.target_title || '内容已删除'}}</text>
                        <text class="target-arrow" wx:if="{{item.target_title}}">›</text>
                    </view>

                    <view class="quote" wx:if="{{item.detail}}">
                        <text class="quote-label">举报说明</text>
                        <text class="quote-text">{{item.detail}}</text>
                    </view>
                    <view class="quote" wx:if="{{item.handle_remark}}">
                        <text class="quote-label">处理备注</text>
                        <text class="quote-text">{{item.handle_remark}}</text>
                    </view>

                    <view class="ops" wx:if="{{item.status === 0}}">
                        <view class="btn btn-plain btn-sm flex1" data-id="{{item.id}}" data-result="0" bindtap="resolveReport" hover-class="btn-press">判定合规</view>
                        <view class="btn btn-danger btn-sm flex1" data-id="{{item.id}}" data-result="1" bindtap="resolveReport" hover-class="btn-press">违规下架</view>
                    </view>
                </view>

                <view class="empty-state" wx:if="{{!reportView.length}}">
                    <view class="empty-mark empty-mark-ok">✓</view>
                    <view class="empty-title">{{reportFilter === 'pending' ? '没有待处理的举报' : '这里还没有举报工单'}}</view>
                    <view class="empty-desc">社区秩序良好，省心了。</view>
                </view>
            </block>

            <!-- ===================== 内容 ===================== -->
            <block wx:elif="{{tab === 'content'}}">
                <view class="filters">
                    <view
                        class="filter {{contentFilter === item.key ? 'filter-on' : ''}}"
                        wx:for="{{contentFilters}}"
                        wx:key="key"
                        data-key="{{item.key}}"
                        bindtap="onContentFilter"
                        hover-class="is-press"
                    >
                        <text>{{item.label}}</text>
                        <text class="filter-num">{{item.key === 'all' ? contentCounts.all : item.key === 'reviewing' ? contentCounts.reviewing : item.key === 'passed' ? contentCounts.passed : contentCounts.rejected}}</text>
                    </view>
                </view>

                <view class="seg-head">
                    <text class="seg-title">菜谱</text>
                    <text class="seg-num num">{{recipeView.length}}</text>
                    <view class="seg-rule"></view>
                </view>

                <view class="row-card anim-in" wx:for="{{recipeView}}" wx:key="id">
                    <image wx:if="{{item.cover}}" class="row-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
                    <view wx:else class="row-cover cover-empty"></view>
                    <view class="row-body">
                        <view class="row-title ellipsis">{{item.name}}</view>
                        <view class="row-meta">
                            <text class="status {{item.statusClass}}">{{item.statusText}}</text>
                            <text class="meta-sep">·</text>
                            <text class="meta-text ellipsis">{{item.owner_name || '匿名'}}</text>
                            <text class="pin-flag" wx:if="{{item.is_top}}">置顶</text>
                        </view>
                        <view class="row-ops">
                            <view class="mini-btn" data-kind="recipe" data-id="{{item.id}}" data-action="{{item.is_top ? 'untop' : 'top'}}" bindtap="contentAction" hover-class="is-press">{{item.is_top ? '取消置顶' : '置顶'}}</view>
                            <view class="mini-btn {{item.auditStatus === 2 ? 'mini-btn-danger' : 'mini-btn-ok'}}" data-kind="recipe" data-id="{{item.id}}" data-action="{{item.auditStatus === 2 ? 'takedown' : 'restore'}}" bindtap="contentAction" hover-class="is-press">{{item.auditStatus === 2 ? '下架' : '恢复'}}</view>
                        </view>
                    </view>
                </view>
                <view class="inline-empty" wx:if="{{!recipeView.length}}">没有符合条件的菜谱</view>

                <view class="seg-head">
                    <text class="seg-title">帖子</text>
                    <text class="seg-num num">{{postView.length}}</text>
                    <view class="seg-rule"></view>
                </view>

                <view class="row-card anim-in" wx:for="{{postView}}" wx:key="id">
                    <image wx:if="{{item.cover}}" class="row-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
                    <view wx:else class="row-cover cover-empty"></view>
                    <view class="row-body">
                        <view class="row-title ellipsis">{{item.title || '无标题'}}</view>
                        <view class="row-meta">
                            <text class="status {{item.statusClass}}">{{item.statusText}}</text>
                            <text class="meta-sep">·</text>
                            <text class="meta-text ellipsis">{{item.owner_name || '匿名'}}</text>
                            <text class="pin-flag" wx:if="{{item.is_top}}">置顶</text>
                        </view>
                        <view class="row-ops">
                            <view class="mini-btn" data-kind="post" data-id="{{item.id}}" data-action="{{item.is_top ? 'untop' : 'top'}}" bindtap="contentAction" hover-class="is-press">{{item.is_top ? '取消置顶' : '置顶'}}</view>
                            <view class="mini-btn {{item.auditStatus === 2 ? 'mini-btn-danger' : 'mini-btn-ok'}}" data-kind="post" data-id="{{item.id}}" data-action="{{item.auditStatus === 2 ? 'takedown' : 'restore'}}" bindtap="contentAction" hover-class="is-press">{{item.auditStatus === 2 ? '下架' : '恢复'}}</view>
                        </view>
                    </view>
                </view>
                <view class="inline-empty" wx:if="{{!postView.length}}">没有符合条件的帖子</view>
            </block>

            <!-- ===================== 用户 ===================== -->
            <block wx:elif="{{tab === 'user'}}">
                <view class="search">
                    <text class="search-glyph">⌕</text>
                    <input
                        class="search-input flex1"
                        value="{{userKeyword}}"
                        placeholder="搜索贡献者昵称"
                        placeholder-class="ph"
                        bindinput="onUserKeyword"
                    />
                    <text class="search-clear" wx:if="{{userKeyword}}" bindtap="clearUserKeyword">清空</text>
                </view>

                <view class="user-card anim-in" wx:for="{{authorView}}" wx:key="uid">
                    <view class="avatar avatar-sm {{item.banned ? 'avatar-muted' : ''}}">{{item.initial}}</view>
                    <view class="row-body">
                        <view class="row-title ellipsis">{{item.name || '未命名用户'}}</view>
                        <view class="row-meta">
                            <text class="meta-text">发布 {{item.count}} 条</text>
                            <text class="status s-reject" wx:if="{{item.banned}}">已封禁</text>
                        </view>
                        <view class="ban-reason ellipsis-2" wx:if="{{item.banned}}">原因：{{item.banReason || '未填写'}}</view>
                    </view>
                    <view
                        class="mini-btn {{item.banned ? 'mini-btn-ok' : 'mini-btn-danger'}} user-op"
                        data-uid="{{item.uid}}"
                        data-banned="{{item.banned ? '1' : '0'}}"
                        bindtap="userAction"
                        hover-class="is-press"
                    >{{item.banned ? '解封' : '封禁'}}</view>
                </view>

                <view class="empty-state" wx:if="{{!authorView.length}}">
                    <view class="empty-mark">人</view>
                    <view class="empty-title">{{userKeyword ? '没搜到这个昵称' : '还没有用户发布过内容'}}</view>
                    <view class="empty-desc">{{userKeyword ? '换个关键词试试。' : '等内容多起来，这里会列出所有贡献者。'}}</view>
                </view>
            </block>

            <!-- ===================== 公告 ===================== -->
            <block wx:elif="{{tab === 'notice'}}">
                <view class="form-card">
                    <view class="field-label">标题</view>
                    <input class="form-input" value="{{noticeTitle}}" placeholder="一句话说清这条公告" placeholder-class="ph" bindinput="onNoticeTitle" />
                    <view class="field-head">
                        <text class="field-label">内容</text>
                        <text class="counter num">{{noticeLen}}/300</text>
                    </view>
                    <textarea class="form-textarea" value="{{noticeContent}}" placeholder="补充细节，会展示在首页公告条" placeholder-class="ph" maxlength="300" bindinput="onNoticeContent" />
                    <view class="btn btn-primary btn-sm form-btn {{canNotice ? '' : 'btn-disabled'}}" bindtap="createNotice" hover-class="btn-press">发布公告</view>
                </view>

                <view class="seg-head">
                    <text class="seg-title">历史公告</text>
                    <text class="seg-num num">{{notices.length}}</text>
                    <view class="seg-rule"></view>
                </view>

                <view class="notice-card anim-in" wx:for="{{notices}}" wx:key="id">
                    <view class="notice-head">
                        <text class="status {{item.statusClass}}">{{item.is_active ? '展示中' : '已隐藏'}}</text>
                        <text class="notice-time">{{item.timeText}}</text>
                    </view>
                    <view class="notice-title ellipsis">{{item.title}}</view>
                    <view class="notice-body ellipsis-2">{{item.content}}</view>
                    <view class="notice-ops">
                        <view class="mini-btn" data-id="{{item.id}}" data-action="toggle" data-active="{{item.is_active ? '1' : '0'}}" bindtap="noticeAction" hover-class="is-press">{{item.is_active ? '隐藏' : '展示'}}</view>
                        <view class="mini-btn mini-btn-danger" data-id="{{item.id}}" data-action="delete" bindtap="noticeAction" hover-class="is-press">删除</view>
                    </view>
                </view>

                <view class="empty-state" wx:if="{{!notices.length}}">
                    <view class="empty-mark">告</view>
                    <view class="empty-title">还没有发过公告</view>
                    <view class="empty-desc">上面填一条，发布后会出现在首页顶部。</view>
                </view>
            </block>

            <!-- ===================== 敏感词 ===================== -->
            <block wx:elif="{{tab === 'word'}}">
                <view class="form-card row-form">
                    <input class="form-input flex1" value="{{newWord}}" placeholder="输入要拦截的词" placeholder-class="ph" bindinput="onWordInput" />
                    <view class="btn btn-primary btn-sm add-word" bindtap="addWord" hover-class="btn-press">添加</view>
                </view>

                <view class="seg-head">
                    <text class="seg-title">词库</text>
                    <text class="seg-num num">{{words.length}}</text>
                    <view class="seg-rule"></view>
                </view>

                <view class="word-box" wx:if="{{words.length}}">
                    <view class="word-chip" wx:for="{{words}}" wx:key="id">
                        <text class="word-text">{{item.word}}</text>
                        <text class="word-x" data-id="{{item.id}}" data-word="{{item.word}}" catchtap="removeWord">×</text>
                    </view>
                </view>
                <view class="inline-empty" wx:if="{{!words.length}}">词库还是空的，先加几个词</view>
            </block>
        </view>
    </block>
</view>
