.page {
    min-height: 100vh;
    background: var(--bg);
}

/* ---------- 顶部排序 ---------- */

.topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 244, 239, 0.94);
    backdrop-filter: blur(12rpx);
    padding: 16rpx 28rpx 10rpx;
}

.sort-row {
    display: flex;
    align-items: center;
    gap: 34rpx;
}

.sort {
    position: relative;
    padding: 12rpx 0 14rpx;
    font-size: var(--fs-base);
    color: var(--ink-500);
    transition: color var(--dur) var(--ease);
}

.sort-active {
    color: var(--ink-900);
    font-weight: 700;
}

.sort-active::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2rpx;
    width: 28rpx;
    height: 5rpx;
    margin-left: -14rpx;
    border-radius: var(--r-pill);
    background: var(--brand-500);
}

.filter-btn {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6rpx;
    height: 58rpx;
    padding: 0 22rpx;
    font-size: 24rpx;
    color: var(--ink-700);
    background: var(--surface);
    border: 2rpx solid var(--line);
    border-radius: var(--r-pill);
}

.filter-btn-on {
    color: var(--brand-600);
    border-color: var(--brand-200);
    background: var(--brand-50);
    font-weight: 500;
}

.filter-count {
    font-variant-numeric: tabular-nums;
}

/* ---------- 筛选面板 ---------- */

.filter-panel {
    margin-top: 12rpx;
    padding: 22rpx 22rpx 24rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-2);
    animation: rise-in 0.24s var(--ease) both;
}

.filter-group {
    margin-bottom: 18rpx;
}

.filter-group:last-of-type {
    margin-bottom: 6rpx;
}

.filter-title {
    display: block;
    font-size: 21rpx;
    font-weight: 600;
    color: var(--ink-400);
    letter-spacing: 1rpx;
    margin-bottom: 12rpx;
}

.filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.filter-reset {
    margin-top: 14rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid var(--line-soft);
    text-align: center;
    font-size: 24rpx;
    color: var(--ink-400);
}

/* ---------- 列表 ---------- */

.list {
    padding-top: 16rpx;
}

.row-card {
    margin-bottom: 18rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    overflow: hidden;
}

.load-more {
    padding: 22rpx 0 40rpx;
    text-align: center;
    font-size: 22rpx;
    color: var(--ink-300);
    letter-spacing: 1rpx;
}

.retry {
    margin-top: 28rpx;
    width: 260rpx;
}

/* ---------- 骨架 ---------- */

.sk-row {
    display: flex;
    gap: 22rpx;
}

.sk-thumb {
    width: 208rpx;
    height: 168rpx;
    border-radius: var(--r-md);
    flex-shrink: 0;
}

.sk-line {
    height: 28rpx;
    margin-bottom: 14rpx;
    border-radius: 8rpx;
}

.sk-line-short {
    width: 55%;
}
