<view class="page">

    <view class="topbar">
        <view class="seg">
            <view class="seg-item {{sort === 'latest' ? 'seg-on' : ''}}" data-sort="latest" bindtap="switchSort">最新</view>
            <view class="seg-item {{sort === 'hot' ? 'seg-on' : ''}}" data-sort="hot" bindtap="switchSort">热门</view>
        </view>
        <text class="topbar-hint">晒成品 · 拍外卖</text>
    </view>

    <view class="container">

        <block wx:if="{{loading}}">
            <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
                <view class="sk-row">
                    <view class="skeleton sk-avatar"></view>
                    <view class="skeleton sk-name"></view>
                </view>
                <view class="skeleton sk-line"></view>
                <view class="skeleton sk-img"></view>
            </view>
        </block>

        <view class="state" wx:elif="{{error}}">
            <text class="state-emoji">🥲</text>
            <text class="state-text">{{error}}</text>
            <button class="btn btn-ghost btn-sm retry" hover-class="btn-press" bindtap="reload">重新加载</button>
        </view>

        <block wx:elif="{{list.length}}">
            <view
                class="post anim-in"
                wx:for="{{list}}"
                wx:key="id"
                data-id="{{item.id}}"
                hover-class="card-press"
                hover-stay-time="80"
                bindtap="goDetail"
            >
                <view class="post-top">
                    <view class="avatar avatar-sm">{{item.initial}}</view>
                    <text class="post-author ellipsis">{{item.owner_name}}</text>
                    <text class="post-badge" wx:if="{{item.isCheckin}}">打卡</text>
                    <text class="post-time">{{item.timeText}}</text>
                </view>

                <view class="post-title">{{item.title}}</view>
                <view class="post-content ellipsis-2" wx:if="{{item.content}}">{{item.content}}</view>

                <view class="post-media" wx:if="{{item.cover}}">
                    <image class="post-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
                </view>

                <view class="post-foot">
                    <text class="post-stat">{{item.like_count}} 赞</text>
                    <text class="post-sep"></text>
                    <text class="post-stat">{{item.collect_count}} 收藏</text>
                    <text class="post-sep"></text>
                    <text class="post-stat">{{item.view_count}} 浏览</text>
                </view>
            </view>

            <view class="load-more" wx:if="{{loadingMore}}">正在加载…</view>
            <view class="load-more" wx:elif="{{!hasMore}}">— 到底了 —</view>
        </block>

        <view class="state" wx:else>
            <text class="state-emoji">🍜</text>
            <text class="state-text">社区还空着，来发第一条</text>
            <button class="btn btn-primary btn-sm retry" hover-class="btn-press" bindtap="goPublish">去发布</button>
        </view>
    </view>

    <view class="fab" hover-class="fab-press" hover-stay-time="80" bindtap="goPublish">
        <text class="fab-plus">＋</text>
    </view>
</view>
