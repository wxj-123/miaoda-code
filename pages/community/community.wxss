@import "../../styles/post.wxss";

.page {
    min-height: 100vh;
    background: var(--bg);
    padding-bottom: 40rpx;
}

/* ---------- 顶部分段 ---------- */

.topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 28rpx 16rpx;
    background: rgba(247, 244, 239, 0.94);
    backdrop-filter: blur(12rpx);
}

.seg {
    display: flex;
    padding: 5rpx;
    background: #ece6dd;
    border-radius: var(--r-pill);
}

.seg-item {
    padding: 0 30rpx;
    height: 58rpx;
    line-height: 58rpx;
    border-radius: var(--r-pill);
    font-size: var(--fs-base);
    color: var(--ink-500);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}

.seg-on {
    background: #ffffff;
    color: var(--ink-900);
    font-weight: 700;
    box-shadow: 0 4rpx 12rpx rgba(70, 45, 25, 0.1);
}

.topbar-hint {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 21rpx;
    color: var(--ink-400);
    letter-spacing: 0.5rpx;
}

.load-more {
    padding: 20rpx 0 50rpx;
    text-align: center;
    font-size: 22rpx;
    color: var(--ink-300);
    letter-spacing: 1rpx;
}

.retry {
    margin-top: 28rpx;
    width: 260rpx;
}

/* ---------- 悬浮发布 ---------- */

.fab {
    position: fixed;
    right: 34rpx;
    bottom: calc(52rpx + env(safe-area-inset-bottom));
    width: 104rpx;
    height: 104rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff8b54, #ef4e19);
    box-shadow: 0 16rpx 34rpx rgba(239, 78, 25, 0.34);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 30;
    transition: transform 0.16s var(--ease);
}

.fab-plus {
    color: #ffffff;
    font-size: 52rpx;
    line-height: 1;
    margin-top: -4rpx;
}

.fab-press {
    transform: scale(0.92);
}

/* ---------- 骨架 ---------- */

.sk-row {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.sk-avatar {
    width: 56rpx;
    height: 56rpx;
    border-radius: 50%;
}

.sk-name {
    width: 180rpx;
    height: 24rpx;
}

.sk-line {
    height: 32rpx;
    margin: 22rpx 0 18rpx;
    border-radius: 8rpx;
}

.sk-img {
    height: 280rpx;
    border-radius: var(--r-md);
}

.state {
    padding: 100rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}
