<view class="page">
    <view class="topbar">
        <view class="seg">
            <view class="seg-item {{tab === 'interaction' ? 'seg-on' : ''}}" data-tab="interaction" bindtap="switchTab">互动</view>
            <view class="seg-item {{tab === 'audit' ? 'seg-on' : ''}}" data-tab="audit" bindtap="switchTab">审核</view>
            <view class="seg-item {{tab === 'system' ? 'seg-on' : ''}}" data-tab="system" bindtap="switchTab">系统</view>
        </view>
    </view>

    <view class="container">
        <view class="state" wx:if="{{loading}}">
            <view class="loading-dots">
                <view class="dot"></view>
                <view class="dot"></view>
                <view class="dot"></view>
            </view>
        </view>

        <block wx:else>
            <!-- 互动 -->
            <block wx:if="{{tab === 'interaction'}}">
                <view class="login-hint" wx:if="{{!signedIn}}" hover-class="is-press" bindtap="goLogin">
                    <text>登录后查看谁评论了你</text>
                    <text class="login-hint-btn">去登录</text>
                </view>
                <block wx:else>
                    <view class="msg anim-in" wx:for="{{interactions}}" wx:key="id" data-target="{{item.target}}" data-id="{{item.targetId}}" hover-class="card-press" hover-stay-time="80" bindtap="goContent">
                        <view class="avatar avatar-sm">{{item.initial}}</view>
                        <view class="flex1">
                            <view class="msg-top">
                                <text class="msg-who ellipsis">{{item.who}}</text>
                                <text class="msg-time">{{item.timeText}}</text>
                            </view>
                            <view class="msg-text ellipsis-2">{{item.content}}</view>
                            <view class="msg-target">在《{{item.targetText}}》下评论</view>
                        </view>
                    </view>
                    <view class="state" wx:if="{{!interactions.length}}">
                        <text class="state-emoji">💬</text>
                        <text class="state-text">还没有新的互动</text>
                    </view>
                </block>
            </block>

            <!-- 审核 -->
            <block wx:elif="{{tab === 'audit'}}">
                <view class="login-hint" wx:if="{{!signedIn}}" hover-class="is-press" bindtap="goLogin">
                    <text>登录后查看审核进度</text>
                    <text class="login-hint-btn">去登录</text>
                </view>
                <block wx:else>
                    <view class="msg anim-in" wx:for="{{audits}}" wx:key="id" data-target="{{item.target}}" data-id="{{item.targetId}}" hover-class="card-press" hover-stay-time="80" bindtap="goContent">
                        <view class="audit-dot {{item.passed ? 'audit-dot-pass' : 'audit-dot-reject'}}">{{item.passed ? '✓' : '!'}}</view>
                        <view class="flex1">
                            <view class="msg-top">
                                <text class="msg-who">{{item.passed ? '审核通过' : '审核未通过'}}</text>
                                <text class="msg-time">{{item.timeText}}</text>
                            </view>
                            <view class="msg-text ellipsis-2">{{item.title}}</view>
                            <view class="msg-target" wx:if="{{!item.passed}}">驳回理由：{{item.reason || '内容不符合社区规范'}}</view>
                        </view>
                    </view>
                    <view class="state" wx:if="{{!audits.length}}">
                        <text class="state-emoji">🗂️</text>
                        <text class="state-text">暂无审核结果</text>
                        <button class="btn btn-ghost btn-sm retry" hover-class="btn-press" bindtap="goContents">查看我的发布</button>
                    </view>
                </block>
            </block>

            <!-- 系统 -->
            <block wx:else>
                <view class="subscribe-card" wx:if="{{signedIn}}" hover-class="card-press" hover-stay-time="80" bindtap="onSubscribe">
                    <view class="flex1">
                        <view class="subscribe-title">开启消息提醒</view>
                        <view class="subscribe-sub">审核结果与评论回复，通过微信服务通知触达</view>
                    </view>
                    <text class="subscribe-action">去开启</text>
                </view>
                <view class="msg anim-in" wx:for="{{notices}}" wx:key="id" data-index="{{index}}" hover-class="card-press" hover-stay-time="80" bindtap="showNotice">
                    <view class="notice-mark">公告</view>
                    <view class="flex1">
                        <view class="msg-top">
                            <text class="msg-who ellipsis">{{item.title}}</text>
                            <text class="msg-time">{{item.timeText}}</text>
                        </view>
                        <view class="msg-text ellipsis-2">{{item.content}}</view>
                    </view>
                </view>
                <view class="state" wx:if="{{!notices.length}}">
                    <text class="state-emoji">📢</text>
                    <text class="state-text">暂时没有公告</text>
                </view>
            </block>
        </block>
    </view>
</view>
