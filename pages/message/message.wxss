.page {
    min-height: 100vh;
    background: var(--bg);
}

/* ---------- 分段 ---------- */

.topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 18rpx 28rpx 14rpx;
    background: rgba(247, 244, 239, 0.94);
    backdrop-filter: blur(12rpx);
}

.seg {
    display: inline-flex;
    padding: 5rpx;
    background: #ece6dd;
    border-radius: var(--r-pill);
}

.seg-item {
    padding: 0 30rpx;
    height: 58rpx;
    line-height: 58rpx;
    border-radius: var(--r-pill);
    font-size: var(--fs-base);
    color: var(--ink-500);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}

.seg-on {
    background: #ffffff;
    color: var(--ink-900);
    font-weight: 700;
    box-shadow: 0 4rpx 12rpx rgba(70, 45, 25, 0.1);
}

.login-hint {
    margin-top: 20rpx;
    padding: 30rpx 26rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 25rpx;
    color: var(--ink-600);
    box-shadow: var(--sh-1);
}

.login-hint-btn {
    color: var(--brand-600);
    font-weight: 600;
}

/* ---------- 消息卡 ---------- */

.msg {
    display: flex;
    gap: 18rpx;
    padding: 26rpx;
    background: var(--surface);
    border-radius: var(--r-lg);
    margin-bottom: 14rpx;
    border: 2rpx solid rgba(237, 230, 221, 0.85);
}

.msg-top {
    display: flex;
    align-items: baseline;
    gap: 12rpx;
}

.msg-who {
    flex: 1;
    min-width: 0;
    font-size: 26rpx;
    font-weight: 600;
    color: var(--ink-800);
}

.msg-time {
    flex-shrink: 0;
    font-size: 20rpx;
    color: var(--ink-300);
}

.msg-text {
    margin-top: 8rpx;
    font-size: 25rpx;
    color: var(--ink-600);
    line-height: 1.6;
}

.msg-target {
    margin-top: 10rpx;
    font-size: 21rpx;
    color: var(--ink-400);
}

/* 审核结果图标 */
.audit-dot {
    width: 56rpx;
    height: 56rpx;
    flex-shrink: 0;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    font-weight: 700;
    color: #ffffff;
}

.audit-dot-pass {
    background: var(--ok);
}

.audit-dot-reject {
    background: var(--danger);
}

.notice-mark {
    width: 56rpx;
    height: 56rpx;
    flex-shrink: 0;
    border-radius: 18rpx;
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: 19rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* ---------- 订阅卡 ---------- */

.subscribe-card {
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 26rpx;
    background: linear-gradient(120deg, #fff4ea, #ffe7d6);
    border-radius: var(--r-lg);
    margin-bottom: 16rpx;
}

.subscribe-title {
    font-size: 26rpx;
    font-weight: 700;
    color: #8a4a22;
}

.subscribe-sub {
    margin-top: 6rpx;
    font-size: 20rpx;
    line-height: 1.5;
    color: #a8764f;
}

.subscribe-action {
    flex-shrink: 0;
    padding: 10rpx 22rpx;
    border-radius: var(--r-pill);
    background: #ffffff;
    font-size: 22rpx;
    font-weight: 600;
    color: var(--brand-600);
}

.state {
    padding: 100rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.retry {
    margin-top: 28rpx;
    width: 280rpx;
}
