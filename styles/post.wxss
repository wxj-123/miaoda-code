/* 社区帖子卡片通用样式：社区流、搜索结果、作者主页共用 */

.post {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 26rpx;
    margin-bottom: 18rpx;
    border: 2rpx solid rgba(237, 230, 221, 0.85);
    transition: transform 0.16s var(--ease, ease), opacity 0.16s var(--ease, ease);
}

.post-top {
    display: flex;
    align-items: center;
    gap: 14rpx;
}

.post-author {
    font-size: 25rpx;
    font-weight: 600;
    color: var(--ink-800);
    flex: 1;
    min-width: 0;
}

.post-time {
    flex-shrink: 0;
    font-size: 21rpx;
    color: var(--ink-300);
}

.post-badge {
    flex-shrink: 0;
    padding: 2rpx 12rpx;
    border-radius: var(--r-pill);
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: 20rpx;
    font-weight: 600;
    line-height: 1.7;
}

.post-title {
    margin-top: 20rpx;
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0.2rpx;
    color: var(--ink-900);
}

.post-content {
    margin-top: 8rpx;
    font-size: var(--fs-base);
    line-height: 1.65;
    color: var(--ink-600);
}

.post-media {
    margin-top: 18rpx;
    border-radius: var(--r-md);
    overflow: hidden;
    line-height: 0;
}

.post-cover {
    width: 100%;
    height: 320rpx;
    background: var(--line-soft);
}

.post-foot {
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 2rpx solid var(--line-soft);
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.post-stat {
    font-size: 21rpx;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
}

.post-sep {
    width: 5rpx;
    height: 5rpx;
    border-radius: 50%;
    background: var(--ink-300);
}

.post-recipe {
    margin-top: 18rpx;
    display: flex;
    align-items: center;
    gap: 16rpx;
    padding: 14rpx 18rpx;
    background: var(--surface-soft);
    border-radius: var(--r-sm);
}
