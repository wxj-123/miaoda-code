  "recipe_steps": [
    {"id":1,"recipe_id":1,"sort":1,"content":"鸡腿肉去骨切 1.5cm 小丁，加生抽、淀粉、少许油抓匀腌 10 分钟。","img_url":null},
    {"id":2,"recipe_id":1,"sort":2,"content":"生抽、香醋、白糖、淀粉加两勺清水调成碗汁备用。","img_url":null},
    {"id":3,"recipe_id":1,"sort":3,"content":"热锅凉油下鸡丁，中大火滑炒至变色盛出。","img_url":null},
    {"id":4,"recipe_id":1,"sort":4,"content":"锅留底油爆香干辣椒、花椒、葱白，倒回鸡丁淋碗汁快速翻匀，关火拌入花生米。","img_url":null},
    {"id":5,"recipe_id":2,"sort":1,"content":"五花肉切薄片，螺丝椒切滚刀块，蒜切片。","img_url":null},
    {"id":6,"recipe_id":2,"sort":2,"content":"热锅不放油，先煸青椒到表面起虎皮盛出。","img_url":null},
    {"id":7,"recipe_id":2,"sort":3,"content":"下五花肉煸出油，加豆豉和蒜片炒香。","img_url":null},
    {"id":8,"recipe_id":2,"sort":4,"content":"倒回青椒，淋生抽大火翻炒 20 秒出锅。","img_url":null},
    {"id":9,"recipe_id":3,"sort":1,"content":"整鸡洗净，锅中水加姜葱烧开，提鸡三提三放让鸡皮收紧。","img_url":null},
    {"id":10,"recipe_id":3,"sort":2,"content":"整鸡下锅，保持水面微沸浸煮 18 分钟，关火再焖 10 分钟。","img_url":null},
    {"id":11,"recipe_id":3,"sort":3,"content":"捞出立即放入冰水浸泡至完全冷却，皮才够爽脆。","img_url":null},
    {"id":12,"recipe_id":3,"sort":4,"content":"斩件装盘，姜葱剁蓉加盐和热油调成蘸料。","img_url":null},
    {"id":13,"recipe_id":4,"sort":1,"content":"番茄顶部划十字，热水烫 30 秒去皮切块。","img_url":null},
    {"id":14,"recipe_id":4,"sort":2,"content":"鸡蛋加少许盐打散，热锅多油炒至半凝固盛出。","img_url":null},
    {"id":15,"recipe_id":4,"sort":3,"content":"番茄下锅加一小匙糖炒出汁，再补少许盐。","img_url":null},
    {"id":16,"recipe_id":4,"sort":4,"content":"倒回鸡蛋翻匀，汤汁略收即可关火。","img_url":null},
    {"id":17,"recipe_id":5,"sort":1,"content":"五花肉切 3cm 方块，冷水下锅焯水去浮沫。","img_url":null},
    {"id":18,"recipe_id":5,"sort":2,"content":"锅中少油下冰糖，小火炒到琥珀色。","img_url":null},
    {"id":19,"recipe_id":5,"sort":3,"content":"下肉块翻炒上色，加老抽、姜片、八角。","img_url":null},
    {"id":20,"recipe_id":5,"sort":4,"content":"加热水没过肉，小火炖 70 分钟，最后大火收汁。","img_url":null},
    {"id":21,"recipe_id":6,"sort":1,"content":"豆腐切 2cm 方块，放入淡盐水中浸 5 分钟去豆腥。","img_url":null},
    {"id":22,"recipe_id":6,"sort":2,"content":"热油炒牛肉末至酥香，加豆瓣酱炒出红油。","img_url":null},
    {"id":23,"recipe_id":6,"sort":3,"content":"加水烧开，下豆腐轻推，小火煮 3 分钟。","img_url":null},
    {"id":24,"recipe_id":6,"sort":4,"content":"分两次勾芡，出锅撒花椒粉和蒜苗末。","img_url":null},
    {"id":25,"recipe_id":7,"sort":1,"content":"鱼收拾干净，两面各划三刀，抹少许盐。","img_url":null},
    {"id":26,"recipe_id":7,"sort":2,"content":"盘底铺姜片葱段，鱼放上，水开后大火蒸 8 分钟。","img_url":null},
    {"id":27,"recipe_id":7,"sort":3,"content":"倒掉盘中腥水，夹走旧姜葱，重新铺葱丝。","img_url":null},
    {"id":28,"recipe_id":7,"sort":4,"content":"淋蒸鱼豉油，再浇一勺滚烫热油。","img_url":null},
    {"id":29,"recipe_id":8,"sort":1,"content":"牛肉逆纹切薄片，加生抽、淀粉、少许油抓匀。","img_url":null},
    {"id":30,"recipe_id":8,"sort":2,"content":"小米椒切圈，香菜切段，蒜切末。","img_url":null},
    {"id":31,"recipe_id":8,"sort":3,"content":"锅烧到冒烟下油，牛肉大火滑炒 15 秒盛出。","img_url":null},
    {"id":32,"recipe_id":8,"sort":4,"content":"爆香蒜末小米椒，倒回牛肉加香菜，翻两下立刻出锅。","img_url":null},
    {"id":33,"recipe_id":9,"sort":1,"content":"小葱切段，冷油下锅小火熬 15 分钟至焦黄。","img_url":null},
    {"id":34,"recipe_id":9,"sort":2,"content":"捞出葱段，油中加生抽、老抽、白糖煮开成葱油汁。","img_url":null},
    {"id":35,"recipe_id":9,"sort":3,"content":"面煮至八分熟，捞出沥干，不要过冷水。","img_url":null},
    {"id":36,"recipe_id":9,"sort":4,"content":"淋两勺葱油汁拌匀，撒回焦葱段。","img_url":null},
    {"id":37,"recipe_id":10,"sort":1,"content":"粉丝温水泡软，铺在盘底。","img_url":null},
    {"id":38,"recipe_id":10,"sort":2,"content":"虾开背去虾线，摆在粉丝上。","img_url":null},
    {"id":39,"recipe_id":10,"sort":3,"content":"蒜蓉一半炸香一半用生的，混合后铺在虾上。","img_url":null},
    {"id":40,"recipe_id":10,"sort":4,"content":"水开后蒸 6 分钟，淋蒸鱼豉油和一勺热油。","img_url":null},
    {"id":41,"recipe_id":11,"sort":1,"content":"干香菇泡发切片，泡菇水留着备用。","img_url":null},
    {"id":42,"recipe_id":11,"sort":2,"content":"青菜对半切开，沸水加盐焯 20 秒捞出过凉。","img_url":null},
    {"id":43,"recipe_id":11,"sort":3,"content":"热锅下蒜末、香菇炒香，加泡菇水和蚝油煮 2 分钟。","img_url":null},
    {"id":44,"recipe_id":11,"sort":4,"content":"下青菜翻匀，勾薄芡出锅。","img_url":null},
    {"id":45,"recipe_id":12,"sort":1,"content":"大米洗净，加少许油和盐腌 20 分钟。","img_url":null},
    {"id":46,"recipe_id":12,"sort":2,"content":"瘦肉切丝加盐淀粉腌好，皮蛋切小丁。","img_url":null},
    {"id":47,"recipe_id":12,"sort":3,"content":"水开后下米，小火煮 30 分钟到米粒开花。","img_url":null},
    {"id":48,"recipe_id":12,"sort":4,"content":"下肉丝煮 2 分钟，加皮蛋和姜丝，盐调味后撒葱花。","img_url":null}
