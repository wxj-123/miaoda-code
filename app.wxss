/* ============================================================
   今天吃什么 · 全局设计系统
   ------------------------------------------------------------
   1. token 层：颜色 / 字号 / 圆角 / 阴影 / 动效
   2. 基础层：布局、文本、标签、按钮、状态、头像
   3. 交互层：按压反馈、骨架屏、入场动效
   页面只需组合这些类，不再各自写死色值
   ============================================================ */

page {
    /* ---- 品牌色（暖橘） ---- */
    --brand-50: #fff6f0;
    --brand-100: #ffe9d9;
    --brand-200: #ffd2b5;
    --brand-300: #ffb085;
    --brand-400: #ff8b54;
    --brand-500: #ff6b35;
    --brand-600: #ef4e19;
    --brand-700: #c43c10;

    /* ---- 中性色（暖灰，与奶油底同调） ---- */
    --ink-900: #1b1917;
    --ink-800: #2c2a26;
    --ink-700: #46433e;
    --ink-600: #615d57;
    --ink-500: #7c766e;
    --ink-400: #9c958c;
    --ink-300: #c0b9af;

    --line: #ede6dd;
    --line-soft: #f5f0e9;
    --bg: #f7f4ef;
    --surface: #ffffff;
    --surface-soft: #fbf9f6;

    /* ---- 语义色 ---- */
    --ok: #2e9e6b;
    --warn: #e8a33d;
    --danger: #d9483b;

    /* ---- 字号 ---- */
    --fs-xs: 22rpx;
    --fs-sm: 24rpx;
    --fs-base: 26rpx;
    --fs-md: 28rpx;
    --fs-lg: 32rpx;
    --fs-xl: 36rpx;
    --fs-2xl: 44rpx;

    /* ---- 圆角 ---- */
    --r-xs: 12rpx;
    --r-sm: 16rpx;
    --r-md: 22rpx;
    --r-lg: 28rpx;
    --r-xl: 36rpx;
    --r-pill: 999rpx;

    /* ---- 阴影（暖调投影，避免灰扑扑） ---- */
    --sh-1: 0 2rpx 8rpx rgba(70, 45, 25, 0.04);
    --sh-2: 0 8rpx 26rpx rgba(70, 45, 25, 0.07);
    --sh-3: 0 18rpx 46rpx rgba(70, 45, 25, 0.11);
    --sh-brand: 0 14rpx 30rpx rgba(239, 78, 25, 0.26);

    /* ---- 动效 ---- */
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --dur: 0.22s;

    min-height: 100%;
    background: var(--bg);
    color: var(--ink-900);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: var(--fs-md);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
}

view,
text,
image,
scroll-view,
input,
textarea {
    box-sizing: border-box;
}

button {
    padding: 0;
    margin: 0;
    background: transparent;
    line-height: normal;
    font-size: var(--fs-md);
    color: inherit;
}

button::after {
    border: none;
}

image {
    display: block;
}

/* ---------- 布局 ---------- */

.page {
    min-height: 100vh;
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.container {
    padding: 0 28rpx;
}

.card {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 28rpx;
    box-shadow: var(--sh-2);
}

.card-flat {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 28rpx;
}

.section {
    margin-top: 40rpx;
}

.section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 22rpx;
}

.section-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: 0.5rpx;
    color: var(--ink-900);
}

.section-more {
    display: flex;
    align-items: center;
    gap: 4rpx;
    font-size: var(--fs-sm);
    color: var(--ink-400);
}

.section-eyebrow {
    margin-bottom: 8rpx;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 3rpx;
    color: var(--brand-500);
    text-transform: uppercase;
}

.row {
    display: flex;
    align-items: center;
}

.row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.flex1 {
    flex: 1;
    min-width: 0;
}

.hairline {
    height: 2rpx;
    background: var(--line-soft);
}

/* ---------- 文本 ---------- */

.muted {
    color: var(--ink-400);
    font-size: var(--fs-sm);
}

.small {
    font-size: var(--fs-sm);
}

.strong {
    font-weight: 600;
}

.num {
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.5rpx;
}

.ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.ellipsis-2 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

.ellipsis-3 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
}

/* ---------- 标签 / 芯片 ---------- */

.tag {
    display: inline-block;
    padding: 3rpx 14rpx;
    border-radius: 8rpx;
    background: var(--brand-50);
    color: var(--brand-600);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.7;
}

.tag-plain {
    display: inline-block;
    padding: 3rpx 14rpx;
    border-radius: 8rpx;
    background: var(--surface-soft);
    border: 2rpx solid var(--line-soft);
    color: var(--ink-500);
    font-size: var(--fs-xs);
    line-height: 1.6;
}

.tag-soft {
    display: inline-block;
    padding: 3rpx 14rpx;
    border-radius: 8rpx;
    background: #eef6f1;
    color: var(--ok);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.7;
}

.chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 62rpx;
    padding: 0 26rpx;
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink-700);
    font-size: var(--fs-base);
    border: 2rpx solid var(--line);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease),
        border-color var(--dur) var(--ease);
}

.chip-sm {
    height: 54rpx;
    padding: 0 22rpx;
    font-size: var(--fs-sm);
}

.chip-active {
    background: linear-gradient(135deg, var(--brand-400), var(--brand-600));
    color: #ffffff;
    border-color: transparent;
    font-weight: 600;
    box-shadow: 0 6rpx 16rpx rgba(239, 78, 25, 0.24);
}

/* ---------- 按钮 ---------- */

.btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88rpx;
    border-radius: var(--r-pill);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: 0.5rpx;
    transition: transform 0.12s var(--ease), opacity 0.12s var(--ease);
}

.btn-primary {
    background: linear-gradient(135deg, var(--brand-400), var(--brand-600));
    color: #ffffff;
    box-shadow: var(--sh-brand);
}

.btn-ghost {
    background: var(--surface);
    color: var(--brand-600);
    border: 2rpx solid var(--brand-200);
}

.btn-plain {
    background: var(--surface-soft);
    color: var(--ink-700);
    border: 2rpx solid var(--line-soft);
}

.btn-sm {
    height: 64rpx;
    padding: 0 28rpx;
    font-size: var(--fs-base);
    font-weight: 500;
}

.btn[disabled] {
    opacity: 0.5;
    box-shadow: none;
}

/* ---------- 交互反馈 ---------- */

/* hover-class 目标：轻按变淡 */
.is-press {
    opacity: 0.72;
}

/* hover-class 目标：卡片回弹 */
.card-press {
    transform: scale(0.982);
    opacity: 0.94;
}

.btn-press {
    transform: scale(0.96);
}

/* ---------- 状态 ---------- */

.state {
    padding: 90rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fade-in 0.3s var(--ease) both;
}

.state-text {
    margin-top: 14rpx;
    font-size: var(--fs-base);
    color: var(--ink-400);
    text-align: center;
    max-width: 460rpx;
    line-height: 1.6;
}

.state-emoji {
    font-size: 64rpx;
    line-height: 1;
    animation: pop-in 0.4s var(--ease) both;
}

.loading-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48rpx 0;
    gap: 12rpx;
}

.dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: var(--brand-300);
    animation: dot-bounce 1.1s var(--ease) infinite;
}

.dot:nth-child(2) {
    animation-delay: 0.12s;
}

.dot:nth-child(3) {
    animation-delay: 0.24s;
}

.divider {
    height: 2rpx;
    background: var(--line-soft);
    margin: 24rpx 0;
}

/* 骨架屏 */
.skeleton {
    background: linear-gradient(90deg, #f1ebe3 25%, #f9f6f1 37%, #f1ebe3 63%);
    background-size: 400% 100%;
    animation: shimmer 1.3s ease infinite;
    border-radius: var(--r-sm);
}

.skeleton-card {
    background: var(--surface);
    border-radius: var(--r-lg);
    padding: 24rpx;
    margin-bottom: 20rpx;
}

/* ---------- 头像 ---------- */

.avatar {
    width: 76rpx;
    height: 76rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-300), var(--brand-500));
    color: #ffffff;
    font-size: var(--fs-lg);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    letter-spacing: 0;
}

.avatar-sm {
    width: 56rpx;
    height: 56rpx;
    font-size: var(--fs-sm);
}

.avatar-lg {
    width: 112rpx;
    height: 112rpx;
    font-size: 42rpx;
}

/* ---------- 底部操作条 ---------- */

.bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(180%) blur(20rpx);
    border-top: 2rpx solid var(--line-soft);
    display: flex;
    align-items: center;
    gap: 18rpx;
    z-index: 20;
}

.bottom-bar .btn {
    flex: 1;
}

.page-with-bar {
    padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

/* ---------- 动效 ---------- */

@keyframes fade-in {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes pop-in {
    from {
        opacity: 0;
        transform: scale(0.86);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes dot-bounce {
    0%,
    60%,
    100% {
        transform: translateY(0);
        opacity: 0.45;
    }
    30% {
        transform: translateY(-10rpx);
        opacity: 1;
    }
}

@keyframes shimmer {
    0% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0 50%;
    }
}

/* 列表逐条入场 */
.anim-in {
    animation: rise-in 0.34s var(--ease) both;
}

.anim-in:nth-child(2) {
    animation-delay: 0.04s;
}

.anim-in:nth-child(3) {
    animation-delay: 0.08s;
}

.anim-in:nth-child(4) {
    animation-delay: 0.12s;
}

.anim-in:nth-child(5) {
    animation-delay: 0.16s;
}

@keyframes rise-in {
    from {
        opacity: 0;
        transform: translateY(16rpx);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
